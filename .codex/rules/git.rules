# Git command policy notes:
# - Rules control commands that request to run outside the sandbox; they do not change sandbox filesystem permissions.
# - With `approvals_reviewer = "auto_review"`, `decision = "prompt"` routes the approval to the automatic reviewer first.
# - Therefore these rules mark high-impact Git operations for review, but they do not guarantee a visible user prompt unless approvals route to the user.

# Publishing local Git history requires explicit user approval.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing publishes repository state and requires explicit user approval.",
)

# Deleting local branches requires explicit user approval.
prefix_rule(
    pattern = ["git", "branch", ["-d", "-D"]],
    decision = "prompt",
    justification = "Deleting local branches can remove unrecovered work and requires explicit user approval.",
)
