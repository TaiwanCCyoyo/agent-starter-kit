{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run python .agent/hooks/session_start.py"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run python .agent/hooks/post_tool_use_hygiene.py"
                    }
                ]
            }
        ]
    }
}
