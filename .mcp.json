{
  "mcpServers": {
    "memory-control": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "${CLAUDE_PROJECT_DIR:-.}/.claude/mcp/memory_control.py"
      ],
      "env": {}
    },
    "memory-db": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "${CLAUDE_PROJECT_DIR:-.}/.memories/memory_store.db"
      ],
      "env": {}
    }
  }
}
