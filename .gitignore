# Ignore local reference clones and disposable workspace files
.references/
.tmp/

# Ignore worktree location
.worktrees/
.claude/worktrees/

# Python Environment & Cache
.venv/
.uv/
__pycache__/
*.pyc

# Tooling Caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*

# Local Secrets & IDE
.env
.claude/settings.local.json
.vscode/*
!.vscode/settings.json
.idea/
